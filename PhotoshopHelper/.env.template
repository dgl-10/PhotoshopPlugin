# ℹ️ IMPORTANT: These keys are ONLY required if you are using the WebHelper feature.
# If you are not using WebHelper, you do not need to provide any API keys here.

# Nebula Configuration (Optional) - Nebula is the author's personal utility that loads secrets from GSM (Google Secret Manager)
# If NEBULA_CS is set, the server will fetch secrets from Nebula Broker at startup.
# Format: "ENV_VAR_NAME=nebula_secret_name,..."
NEBULA_CS=

# Local API Keys (used if Nebula is NOT configured)
XAI_API_KEY=
FAL_API_KEY=
REPLICATE_API_KEY=
BFL_API_KEY=

# ── Local server authentication ─────────────────────────────────────────────
# PhotoshopHelper always protects its local HTTP server with generated secrets.
# You do not need to set anything below for normal use — the Photoshop plugin
# is paired with its token automatically, and the WebHelper page works from
# the same origin without one. See SECURITY.md for the full access model.

# Overrides the auto-generated token for /api/local/v1/* (the service-to-service
# generation API used by scripts and the local MCP server). Leave empty to use
# the token generated on first run — copy it from the tray menu (Access Tokens ->
# Copy Local API Token) or export it via (Save Local API Token to User Environment...).
# Restart the app after changing it.
PHOTOSHOP_HELPER_LOCAL_API_TOKEN=

# Only needed when you deliberately expose WebHelper beyond this machine, for
# example through an ngrok/cloudflared tunnel. When set, opening the WebHelper
# page asks for this password (HTTP Basic). Leave empty to keep the existing
# password-free local behavior — same-origin access is unaffected either way.
WEBHELPER_ACCESS_PASSWORD=

# CUSTOM KEYS: add any key here (e.g. MY_KEY=abc123) and reference it
# inside providers.json as {{ env:MY_KEY }}.

# SECURITY NOTE: You can also protect your keys using System Environment Variables,
# Secret Vaults, or Password Managers.
# Search the web for: "how to protect secrets in .env file" if unsure.

# IMPORTANT: Changes to this file require an application restart to take effect.
# Quit and relaunch PhotoshopHelper after saving.
