{
    "name": "photoshop-helper",
    "version": "1.2.0",
    "ps-plugin-version": "1.1.1",
    "description": "Companion app for Photoshop UXP plugin - provides clipboard, drag & drop, and AI WebHelper functionality",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "test": "node --test _tests_/*.test.js",
        "dist:win": "electron-builder --win",
        "dist:mac": "electron-builder --mac",
        "dist": "electron-builder --win --mac"
    },
    "keywords": [
        "photoshop",
        "electron",
        "clipboard",
        "drag-drop",
        "ai"
    ],
    "author": "",
    "license": "CC-BY-NC-SA-4.0",
    "dependencies": {
        "dotenv": "^17.3.1",
        "electron-log": "^5.0.0",
        "electron-store": "^11.0.2",
        "electron-updater": "^6.1.0",
        "express": "^4.18.2",
        "json5": "^2.2.3"
    },
    "devDependencies": {
        "electron": "^32.0.0",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.photoshop-helper",
        "productName": "PhotoshopHelper",
        "publish": {
            "provider": "github",
            "owner": "dgl-10",
            "repo": "PhotoshopPlugin"
        },
        "files": [
            "**/*",
            "!providers.json",
            "!.env",
            "!user-settings.json",
            "!_tests_/**",
            "!**/*.md",
            "!node_modules/.cache/**",
            "!**/*.map",
            "!webhelper/v0/**"
        ],
        "extraResources": [
            {
                "from": "../plugin.ccx",
                "to": "plugin.ccx"
            },
            {
                "from": ".env.template",
                "to": ".env.template"
            },
            {
                "from": "providers.template.json",
                "to": "providers.template.json"
            },
            {
                "from": "Prompt_Providers_Configuration.md",
                "to": "Prompt_Providers_Configuration.md"
            },
            {
                "from": "Providers_Configuration_Guide.md",
                "to": "Providers_Configuration_Guide.md"
            },
            {
                "from": "Local_Generation_API.md",
                "to": "Local_Generation_API.md"
            }
        ],
        "extraFiles": [
            {
                "from": "../LICENSE",
                "to": "LICENSE.txt"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "../icons/win/icon.ico"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "../icons/mac/icon.icns",
            "category": "public.app-category.utilities"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "deleteAppDataOnUninstall": true,
            "include": "../installer.nsh"
        }
    }
}