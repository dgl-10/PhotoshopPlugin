    "response_handlers": {},
    "providers": [
        {
            "id": "civitai_krea2",
            "generation_modes": [
                "t2i",
                "i2i"
            ],
            "name": "Krea 2 - via Civitai API Key (Yellow Buzz, from ~$0.045/img)",
            "tags": {
                "provider": "civitai",
                "family": "krea"
            },
            "remarks": "• <b>Pricing:</b> Flat per image in Yellow Buzz (1,000 Buzz ≈ $1.00 + ~15% crypto fee overhead, ~$0.00115/Buzz):<br>&nbsp;&nbsp;- Medium: ~39 Buzz (~$0.045)<br>&nbsp;&nbsp;- Large: ~78 Buzz (~$0.090)<br>&nbsp;&nbsp;- Style References: +6.5 Buzz (~$0.0075) surcharge when reference images are attached",
            "image_format": "data_uri",
            "max_reference_images": 10,
            "supports_negative_prompt": false,
            "english_only": false,
            "mask_handling": {
                "supported": false,
                "required": false
            },
            "allowed_aspect_ratios": [
                "16:9",
                "3:2",
                "4:3",
                "1:1",
                "4:5",
                "2:3",
                "9:16"
            ],
            "nice_name": {
                "default": "Krea 2 (Civitai Key)",
                "depends_on": "size",
                "values": {
                    "medium": "Krea 2 Medium (Civitai Key)",
                    "large": "Krea 2 Large (Civitai Key)"
                }
            },
            "filename_suffix": {
                "default": "krea2",
                "depends_on": "size",
                "values": {
                    "medium": "krea2_medium",
                    "large": "krea2_large"
                }
            },
            "preprocessor": [
                {
                    "name": "image_get_size",
                    "args": {
                        "max_size": 2048,
                        "min_size": 256,
                        "step": 16,
                        "auto_resize_2_max": true
                    }
                }
            ],
            "request_config": {
                "single_image_per_request": false,
                "endpoint_url": "https://orchestration.civitai.com/v2/consumer/workflows?whatif=false&wait=0",
                "method": "POST",
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer {{env:CIVITAI_API_KEY}}"
                },
                "reference_item_template": {
                    "imageUrl": "{{item}}",
                    "strength": 1.0
                },
                "body_template": {
                    // Strictly enforce settlement via Yellow Buzz
                    "currencies": [
                        "yellow"
                    ],
                    // Permit uncensored / mature generations
                    "allowMatureContent": true,
                    "steps": [
                        {
                            "$type": "imageGen",
                            "input": {
                                "engine": "fal",
                                "model": "krea2",
                                "operation": "createImage",
                                "size": "{{size}}",
                                "prompt": "{{prompt}}",
                                "{{?calculated_output_aspect_ratio}}aspectRatio": "{{calculated_output_aspect_ratio}}",
                                "{{?!calculated_output_aspect_ratio && aspect_ratio}}aspectRatio": "{{aspect_ratio}}",
                                "{{?!calculated_output_aspect_ratio && !aspect_ratio}}aspectRatio": "1:1",
                                "creativity": "{{creativity}}",
                                "quantity": "{{num_images}}",
                                // Style reference images (up to 10 supported, incurs +6.5 Buzz surcharge)
                                "{{?source_image}}imageStyleReferences": [
                                    {
                                        "imageUrl": "{{source_image}}",
                                        "strength": 1.0
                                    },
                                    "{{resolved_references}}"
                                ]
                            }
                        }
                    ]
                }
            },
            "response_config": {
                "$ref": "civitai"
            },
            "parameters": [
                {
                    "name": "prompt",
                    "type": "string",
                    "alias": "prompt",
                    "label": "Text Prompt",
                    "default": ""
                },
                {
                    "name": "size",
                    "type": "dropdown",
                    "alias": "output_resolution",
                    "label": "Model Tier / Size",
                    "options": [
                        {
                            "value": "medium",
                            "alias": "std",
                            "label": "Medium (Fast - 39 Buzz ≈ ~$0.045)"
                        },
                        {
                            "value": "medium",
                            "alias": "high",
                            "hidden": true
                        },
                        {
                            "value": "large",
                            "alias": "ultra",
                            "label": "Large (Hero Quality - 78 Buzz ≈ ~$0.090)"
                        }
                    ],
                    "default": "medium"
                },
                {
                    "name": "creativity",
                    "type": "dropdown",
                    "label": "Creativity Level",
                    "options": [
                        {
                            "value": "raw",
                            "label": "Raw (Strict Prompt Adherence)"
                        },
                        {
                            "value": "low",
                            "label": "Low"
                        },
                        {
                            "value": "medium",
                            "label": "Medium (Balanced)"
                        },
                        {
                            "value": "high",
                            "label": "High (Artistic Freedom / Richer Details)"
                        }
                    ],
                    "default": "medium"
                }
            ]
        },
